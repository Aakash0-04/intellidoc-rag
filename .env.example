# --- LLM (pick one, Groq is free & fast) ---
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama3-8b-8192

# --- Embeddings (Jina API = no local model) ---
JINA_API_KEY=jina_...

# --- Qdrant Cloud ---
QDRANT_URL=https://xxxxxx.cloud.qdrant.io
QDRANT_API_KEY=...
QDRANT_COLLECTION_NAME=rag_documents

# --- LangSmith (optional, for tracing) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=rag-project

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5